rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Global reusable security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for UserProfile
    function isValidUserProfile(data) {
      return data.userId == request.auth.uid &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Validation helper for EventItem
    function isValidEventItem(data, userId) {
      return data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.dateDay is int && data.dateDay >= 1 && data.dateDay <= 31 &&
             data.dateMonth is int && data.dateMonth >= 1 && data.dateMonth <= 12 &&
             (!('birthYear' in data) || data.birthYear == null || (data.birthYear is int && data.birthYear >= 1800 && data.birthYear <= 2100)) &&
             data.eventType is string && data.eventType in ['BIRTHDAY', 'ANNIVERSARY', 'SPECIAL_DAY', 'OTHER'] &&
             (!('relationship' in data) || (data.relationship is string && data.relationship in ['FRIEND', 'FAMILY', 'WORK', 'LOVE', 'OTHER'])) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('isReminderEnabled' in data) || data.isReminderEnabled is bool) &&
             (!('reminderDaysBefore' in data) || (data.reminderDaysBefore is int && data.reminderDaysBefore >= 0 && data.reminderDaysBefore <= 30)) &&
             (!('reminderHour' in data) || (data.reminderHour is int && data.reminderHour >= 0 && data.reminderHour <= 23)) &&
             (!('reminderMinute' in data) || (data.reminderMinute is int && data.reminderMinute >= 0 && data.reminderMinute <= 59)) &&
             (!('isWishedThisYear' in data) || data.isWishedThisYear is bool) &&
             (!('wishedYear' in data) || data.wishedYear == null || (data.wishedYear is int && data.wishedYear >= 1900 && data.wishedYear <= 2100)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == userId &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      // User's private events subcollection
      match /events/{eventId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(eventId) &&
                         incoming().userId == userId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidEventItem(incoming(), userId);

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(eventId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidEventItem(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'dateDay', 'dateMonth', 'birthYear', 'eventType',
                           'relationship', 'notes', 'isReminderEnabled', 'reminderDaysBefore',
                           'reminderHour', 'reminderMinute', 'isWishedThisYear', 'wishedYear', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(eventId);
      }
    }
  }
}
